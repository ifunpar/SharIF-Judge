# gitignore file for SharIF Judge

.git
.idea
application/config/database.php
application/config/secrets.php
application/config/config.php

# Ignore Twig Cache Files
application/cache/Twig/*/

# Ignore Compiled EasySandbox Files
tester/easysandbox/EasySandbox.o
tester/easysandbox/EasySandbox.so
tester/easysandbox/malloc.o
tester/easysandbox/t/*
!tester/easysandbox/t/*.c*

# Ignore MOSS File
tester/moss

# Ignore Testing Assignment
assignments/

application/logs/*
system_old/
logs/*